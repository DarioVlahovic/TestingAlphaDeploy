@page "/"
@inject IConfiguration Configuration

<PageTitle>TestingAlphaDeploy - Production Ready v2</PageTitle>

<h1>⚡ PRODUCTION DEPLOY - Verzija 10.0! ⚡</h1>

<p>Deploy test bez konflikta - vidljiva izmjena naslova i nove poruke.</p>

<div class="alert alert-warning mt-4">
    <h4>⚠️ MASTER VERZIJA 7.0 - KONFLIKT PROMJENA!</h4>
    <p>Ova promjena će SIGURNO konfliktati s publish verzijom!</p>
    <p>Test conflict resolution u deployment procesu.</p>
    <p><em>Updated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</em></p>
</div>

<div class="alert alert-success mt-4">
    <h4>✨ Nova sekcija - Automatski merge bez konflikta</h4>
    <p>Ova sekcija je dodana na <strong>master</strong> grani.</p>
    <p>Automatski će se spojiti jer ne postoji na publish grani!</p>
    <ul>
        <li>✅ Merge test uspješan</li>
        <li>🔧 Deployment automatski pokrenut</li>
        <li>🚀 Portainer update izvršen</li>
    </ul>
</div>

<hr class="my-5" />

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h5>📊 Deployment Statistics</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <h6>Total Merges</h6>
                <p class="display-6">@totalMerges</p>
            </div>
            <div class="col-md-4">
                <h6>Successful Deploys</h6>
                <p class="display-6">@successfulDeploys</p>
            </div>
            <div class="col-md-4">
                <h6>Server Status</h6>
                <p class="display-6">🟢 Online</p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4">
    <h6>ℹ️ Project Info</h6>
    <p><strong>Repository:</strong> TestingAlphaDeploy</p>
    <p><strong>Pipeline:</strong> Docker-Portainer</p>
    <p><strong>Server:</strong> 192.168.21.52</p>
    <p><strong>Last Updated:</strong> @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
</div>

<div class="card mt-4 border-secondary">
    <div class="card-header bg-dark text-white">
        <h5>🔐 Environment Secrets Status</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Variable</th>
                    <th>Status</th>
                    <th>Value Preview</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var secret in secrets)
                {
                    <tr>
                        <td><code>@secret.Key</code></td>
                        <td>
                            @if (secret.IsSet)
                            {
                                <span class="badge bg-success">✅ SET</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">❌ NOT SET</span>
                            }
                        </td>
                        <td><small class="text-muted">@secret.Preview</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {
    private int totalMerges = 5;
    private int successfulDeploys = 4;

    private record SecretStatus(string Key, bool IsSet, string Preview);

    private List<SecretStatus> secrets = [];

    protected override void OnInitialized()
    {
        var keysToCheck = new[]
        {
            "APP_SECRET",
            "API_KEY",
            "DB_CONNECTION_STRING",
            "PORTAINER_TOKEN",
            "DEPLOY_ENV"
        };

        secrets = keysToCheck.Select(key =>
        {
            var value = Configuration[key] ?? Environment.GetEnvironmentVariable(key);
            var isSet = !string.IsNullOrEmpty(value);
            var preview = isSet
                ? value!.Length <= 4
                    ? "****"
                    : value[..2] + new string('*', Math.Min(value.Length - 2, 6)) + "..."
                : "—";
            return new SecretStatus(key, isSet, preview);
        }).ToList();
    }
}


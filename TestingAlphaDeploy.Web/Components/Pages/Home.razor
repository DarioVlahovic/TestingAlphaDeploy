@page "/"

<PageTitle>TestingAlphaDeploy - Home</PageTitle>

<h1>🎯 TestingAlphaDeploy - Automatski Merge Test! 🚀</h1>

<p>Welcome to your new app. Ova promjena se automatski mergea bez konflikta!</p>

<div class="alert alert-danger mt-4">
    <h4>🔥 MASTER VERZIJA 6.0 - NOVI KONFLIKT</h4>
    <p>Testiranje novog konflikta sa čistim stanjem!</p>
    <p><em>Timestamp: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</em></p>
</div>

<div class="alert alert-success mt-4">
    <h4>✨ Nova sekcija - Automatski merge bez konflikta</h4>
    <p>Ova sekcija je dodana na <strong>master</strong> grani.</p>
    <p>Automatski će se spojiti jer ne postoji na publish grani!</p>
    <ul>
        <li>✅ Merge test uspješan</li>
        <li>🔧 Deployment automatski pokrenut</li>
        <li>🚀 Portainer update izvršen</li>
    </ul>
</div>

<hr class="my-5" />

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h5>📊 Deployment Statistics</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <h6>Total Merges</h6>
                <p class="display-6">@totalMerges</p>
            </div>
            <div class="col-md-4">
                <h6>Successful Deploys</h6>
                <p class="display-6">@successfulDeploys</p>
            </div>
            <div class="col-md-4">
                <h6>Server Status</h6>
                <p class="display-6">🟢 Online</p>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalMerges = 5;
    private int successfulDeploys = 4;
}

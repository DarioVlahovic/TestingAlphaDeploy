@page "/"
@inject IConfiguration Configuration
@inject RedisService Redis

<PageTitle>TestingAlphaDeploy - Production Ready v2</PageTitle>
<PageTitle>TestingAlphaDeploy - Publish Branch</PageTitle>

<h1>⚡ PRODUCTION DEPLOY - Verzija 10.0! ⚡</h1>
<h1>🔵 PUBLISH GRANA - Verzija 9.0 (KONFLIKT INCOMING!) 🔵</h1>

<p>Deploy test bez konflikta - vidljiva izmjena naslova i nove poruke.</p>
<p>Ova verzija je SAMO na publish grani i konfliktirati će s masterom!</p>

<div class="alert alert-info mt-4">
    <h4>✅ PUBLISH VERZIJA 2.0</h4>
    <p>Promjena direktno na <strong>publish</strong> grani.</p>
    </div>
<div class="alert alert-danger mt-4">
    <h4>🔥 MASTER VERZIJA 6.0 - NOVI KONFLIKT</h4>
    <p>Testiranje novog konflikta sa čistim stanjem!</p>
    <p><em>Timestamp: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</em></p>
    </div>
<div class="alert alert-warning mt-4">
    <h4>⚠️ MASTER VERZIJA 7.0 - KONFLIKT PROMJENA!</h4>
    <p>Ova promjena će SIGURNO konfliktati s publish verzijom!</p>
    <p>Test conflict resolution u deployment procesu.</p>
    <p><em>Updated: @DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss")</em></p>
</div>

<div class="alert alert-success mt-4">
    <h4>✨ Nova sekcija - Automatski merge bez konflikta</h4>
    <p>Ova sekcija je dodana na <strong>master</strong> grani.</p>
    <p>Automatski će se spojiti jer ne postoji na publish grani!</p>
    <ul>
        <li>✅ Merge test uspješan</li>
        <li>🔧 Deployment automatski pokrenut</li>
        <li>🚀 Portainer update izvršen</li>
    </ul>
</div>

<hr class="my-5" />

<div class="card mt-4">
    <div class="card-header bg-primary text-white">
        <h5>📊 Deployment Statistics</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-4">
                <h6>Total Merges</h6>
                <p class="display-6">@totalMerges</p>
            </div>
            <div class="col-md-4">
                <h6>Successful Deploys</h6>
                <p class="display-6">@successfulDeploys</p>
            </div>
            <div class="col-md-4">
                <h6>Server Status</h6>
                <p class="display-6">🟢 Online</p>
            </div>
        </div>
    </div>
</div>

<div class="alert alert-info mt-4">
    <h6>ℹ️ Project Info</h6>
    <p><strong>Repository:</strong> TestingAlphaDeploy</p>
    <p><strong>Pipeline:</strong> Docker-Portainer</p>
    <p><strong>Server:</strong> 192.168.21.52</p>
    <p><strong>Last Updated:</strong> @DateTime.Now.ToString("dd.MM.yyyy HH:mm")</p>
</div>

<div class="card mt-4 border-secondary">
    <div class="card-header bg-dark text-white">
        <h5>🔐 Environment Secrets Status</h5>
    </div>
    <div class="card-body">
        <table class="table table-sm">
            <thead>
                <tr>
                    <th>Variable</th>
                    <th>Status</th>
                    <th>Value Preview</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var secret in secrets)
                {
                    <tr>
                        <td><code>@secret.Key</code></td>
                        <td>
                            @if (secret.IsSet)
                            {
                                <span class="badge bg-success">✅ SET</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">❌ NOT SET</span>
                            }
                        </td>
                        <td><small class="text-muted">@secret.Preview</small></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="card mt-4 @(redisConnected ? "border-success" : "border-danger")">
    <div class="card-header @(redisConnected ? "bg-success" : "bg-danger") text-white">
        <h5>🗄️ Redis Status</h5>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-md-3">
                <h6>Connection</h6>
                <p class="fs-5">
                    @if (redisConnected)
                    {
                        <span class="badge bg-success">🟢 Connected</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">🔴 Disconnected</span>
                    }
                </p>
            </div>
            <div class="col-md-3">
                <h6>Ping</h6>
                <p class="fs-5">@(redisPing.HasValue ? $"{redisPing.Value.TotalMilliseconds:F1} ms" : "N/A")</p>
            </div>
            <div class="col-md-3">
                <h6>Test Write/Read</h6>
                <p class="fs-5">
                    @if (redisTestPassed)
                    {
                        <span class="badge bg-success">✅ PASS</span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark">❌ FAIL</span>
                    }
                </p>
            </div>
            <div class="col-md-3">
                <h6>Info</h6>
                <p class="fs-6 text-muted">@redisInfo</p>
            </div>
        </div>
        @if (redisTestValue is not null)
        {
            <div class="alert alert-light mt-2 mb-0">
                <small><strong>Test key:</strong> <code>alpha_deploy_test</code> = <code>@redisTestValue</code></small>
            </div>
        }
    </div>
</div>

@code {
    private int totalMerges = 5;
    private int successfulDeploys = 4;

    private bool redisConnected;
    private TimeSpan? redisPing;
    private bool redisTestPassed;
    private string redisInfo = "";
    private string? redisTestValue;

    private record SecretStatus(string Key, bool IsSet, string Preview);
    private List<SecretStatus> secrets = [];

    protected override async Task OnInitializedAsync()
    {
        // Redis checks
        redisConnected = await Redis.IsConnectedAsync();
        redisPing = await Redis.PingAsync();
        redisInfo = Redis.GetConnectionInfo();

        if (redisConnected)
        {
            var testVal = $"working-{DateTime.UtcNow:HHmmss}";
            await Redis.SetValueAsync("alpha_deploy_test", testVal, TimeSpan.FromMinutes(5));
            redisTestValue = await Redis.GetValueAsync("alpha_deploy_test");
            redisTestPassed = redisTestValue == testVal;
        }

        // Env secrets check
        var keysToCheck = new[]
        {
            "APP_SECRET",
            "API_KEY",
            "DB_CONNECTION_STRING",
            "PORTAINER_TOKEN",
            "DEPLOY_ENV",
            "REDIS_CONNECTION"
        };

        secrets = keysToCheck.Select(key =>
        {
            var value = Configuration[key] ?? Environment.GetEnvironmentVariable(key);
            var isSet = !string.IsNullOrEmpty(value);
            var preview = isSet
                ? value!.Length <= 4
                    ? "****"
                    : value[..2] + new string('*', Math.Min(value.Length - 2, 6)) + "..."
                : "—";
            return new SecretStatus(key, isSet, preview);
        }).ToList();
    }
}

